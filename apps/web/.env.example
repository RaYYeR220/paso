# Network the server works on: testnet or mainnet.
PASO_NETWORK=testnet

# Secret key (S...) of the Stellar account that pays the fee of every relayed transaction. It pays fees and nothing else.
RELAYER_SECRET=

# Private key (0x...) of the Base Sepolia account behind the testnet faucet. Leave empty to switch the faucet off.
DEMO_PAYER_PRIVATE_KEY=

# Optional. Soroban RPC endpoint; defaults to the public endpoint of the network.
STELLAR_RPC_URL=

# Optional. RPC endpoint for Base; defaults to the chain's public endpoint.
BASE_RPC_URL=

# Optional. The most a relayed call may cost in resource fees, in stroops. Defaults to 5000000 (0.5 XLM).
RELAYER_MAX_RESOURCE_FEE=

# Optional. Faucet requests one caller address may make per hour. Defaults to 5.
DEMO_FUND_PER_IP_PER_HOUR=

# Optional. Faucet requests for one owner per day. Defaults to 2.
DEMO_FUND_PER_OWNER_PER_DAY=

# Tests and scripts: Ethereum private key (0x...) of an owner whose account is deployed on testnet.
PASO_E2E_OWNER_KEY=

# Tests and scripts: secret key (S...) of any funded Stellar testnet account. It may be the relayer's.
PASO_E2E_SOURCE_SECRET=

# Scripts, optional: Ethereum private key (0x...) that pays the burn on Base Sepolia. Defaults to DEMO_PAYER_PRIVATE_KEY, then PASO_E2E_OWNER_KEY.
PASO_E2E_PAYER_KEY=
