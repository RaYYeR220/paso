# Network the server works on: testnet or mainnet.
PASO_NETWORK=testnet

# Must be "true" for PASO_NETWORK=mainnet to be accepted: real funds are never used by default.
PASO_ALLOW_MAINNET=

# Secret key (S...) of the Stellar account that pays the fee of every relayed transaction. It pays fees and nothing else.
RELAYER_SECRET=

# Private key (0x...) of the server's account on Base: it burns for the testnet faucet and pays the gas of mints that finish a transfer back to Base. Leave empty to switch both off.
DEMO_PAYER_PRIVATE_KEY=

# Optional. Soroban RPC endpoint; defaults to the public endpoint of the network.
STELLAR_RPC_URL=

# Optional. RPC endpoint for Base; defaults to the chain's public endpoint.
BASE_RPC_URL=

# Optional. The most one transaction of the relayer may cost in resource fees, in stroops. Defaults to 5000000 (0.5 XLM).
RELAYER_MAX_RESOURCE_FEE=

# Optional. The most the relayer spends on fees in any 24 hours, in stroops. Defaults to 500000000 (50 XLM).
RELAYER_MAX_DAILY_FEES=

# Optional. Faucet requests one caller address may make per hour. Defaults to 5.
DEMO_FUND_PER_IP_PER_HOUR=

# Optional. Faucet requests for one owner per day. Defaults to 2.
DEMO_FUND_PER_OWNER_PER_DAY=

# Optional. Faucet payouts in any 24 hours, whoever asks. Defaults to 50.
DEMO_FUND_PER_DAY=

# Optional. USDC the faucet's payer keeps, in 6-decimal units: no payout takes it below this. Defaults to 2000000 (2 USDC).
DEMO_FUND_PAYER_FLOOR=

# Optional. Mints on Base the server pays the gas for, per caller in an hour. Defaults to 10.
BASE_MINTS_PER_CALLER_PER_HOUR=

# Optional. Mints on Base the server pays the gas for in any 24 hours, whoever asks. Defaults to 100.
BASE_MINTS_PER_DAY=

# Optional. ETH the server's account on Base keeps, in wei: below it the server stops paying for mints. Defaults to 100000000000000 (0.0001 ETH).
BASE_MINT_PAYER_ETH_FLOOR=

# Optional. The most the server offers per unit of gas for a mint on Base, in wei; while Base asks more, it does not mint. Defaults to 250000000 (0.25 gwei).
BASE_MINT_MAX_FEE_PER_GAS=

# Must be "true", on top of PASO_ALLOW_MAINNET, for the server to pay for mints on Base on mainnet. Off by default: any wallet can submit the mint.
PAY_BASE_MINTS_ON_MAINNET=

# Tests and scripts: Ethereum private key (0x...) of an owner whose account is deployed on testnet.
PASO_E2E_OWNER_KEY=

# Tests and scripts: secret key (S...) of any funded Stellar testnet account. It may be the relayer's.
PASO_E2E_SOURCE_SECRET=

# Scripts, optional: Ethereum private key (0x...) that pays the burn on Base Sepolia. Defaults to DEMO_PAYER_PRIVATE_KEY, then PASO_E2E_OWNER_KEY.
PASO_E2E_PAYER_KEY=
