# The server works on testnet with the settings below. It works on mainnet as well, at the same time and from the same
# routes, only when both PASO_ALLOW_MAINNET=true and RELAYER_SECRET_MAINNET are set (see "Mainnet" further down).
# Each request names its network; each network has its own relayer account, queue, limits and budget.

# The network a request means when it names none: testnet or mainnet. Defaults to testnet.
PASO_NETWORK=testnet

# Secret key (S...) of the Stellar account that pays the fee of every relayed transaction. It pays fees and nothing else.
RELAYER_SECRET=

# Private key (0x...) of the server's account on Base: it burns for the testnet faucet and pays the gas of mints that finish a transfer back to Base. Leave empty to switch both off.
DEMO_PAYER_PRIVATE_KEY=

# Optional. Soroban RPC endpoint; defaults to the public endpoint of the network.
STELLAR_RPC_URL=

# Optional. RPC endpoint for Base; defaults to the chain's public endpoint.
BASE_RPC_URL=

# Optional. The most one transaction of the relayer may cost in resource fees, in stroops. Defaults to 5000000 (0.5 XLM).
RELAYER_MAX_RESOURCE_FEE=

# Optional. The most the relayer spends on fees in any 24 hours, in stroops. Defaults to 500000000 (50 XLM).
RELAYER_MAX_DAILY_FEES=

# Optional. What a transaction bids to be included in a ledger, in stroops, on top of its resource fee. Doubled each
# time a transaction that no ledger took is sent again (at most three are sent). Defaults to 1000.
RELAYER_INCLUSION_FEE=

# Optional. What the relayer account keeps, in stroops: nothing is sent that would take its balance below this.
# Defaults to 0 (no floor).
RELAYER_MIN_BALANCE=

# Optional. Transactions the relayer pays for in an hour, by kind: from one caller, and from everyone together.
# Defaults: 120 and 1200 relayed calls, 60 and 600 account deployments, 60 and 600 deliveries.
RELAYS_PER_CALLER_PER_HOUR=
RELAYS_PER_HOUR=
DEPLOYS_PER_CALLER_PER_HOUR=
DEPLOYS_PER_HOUR=
DELIVERIES_PER_CALLER_PER_HOUR=
DELIVERIES_PER_HOUR=

# Optional. Faucet requests one caller address may make per hour. Defaults to 5.
DEMO_FUND_PER_IP_PER_HOUR=

# Optional. Faucet requests for one owner per day. Defaults to 2.
DEMO_FUND_PER_OWNER_PER_DAY=

# Optional. Faucet payouts in any 24 hours, whoever asks. Defaults to 50.
DEMO_FUND_PER_DAY=

# Optional. USDC the faucet's payer keeps, in 6-decimal units: no payout takes it below this. Defaults to 2000000 (2 USDC).
DEMO_FUND_PAYER_FLOOR=

# Optional. Mints on Base the server pays the gas for, per caller in an hour. Defaults to 10.
BASE_MINTS_PER_CALLER_PER_HOUR=

# Optional. Mints on Base the server pays the gas for in any 24 hours, whoever asks. Defaults to 100.
BASE_MINTS_PER_DAY=

# Optional. ETH the server's account on Base keeps, in wei: below it the server stops paying for mints. Defaults to 100000000000000 (0.0001 ETH).
BASE_MINT_PAYER_ETH_FLOOR=

# Optional. The most the server offers per unit of gas for a mint on Base, in wei; while Base asks more, it does not mint. Defaults to 250000000 (0.25 gwei).
BASE_MINT_MAX_FEE_PER_GAS=

# Optional. Set to "false" to stop the server paying for mints on Base Sepolia. A transfer back is then finished the
# way it is on mainnet: the server hands the attested message back and the owner's wallet submits the mint.
PAY_BASE_MINTS_ON_TESTNET=

# --- Mainnet ---------------------------------------------------------------------------------------------------------
# Real funds. Nothing below is read unless PASO_ALLOW_MAINNET is "true", and mainnet reads none of the settings above:
# every one of its own ends in _MAINNET. Without both of the first two, requests for mainnet are answered
# 503 { error: "unavailable", reason: "not_serving" } and the app says the hosted relayer is not serving mainnet.

# Must be "true" for the server to work on mainnet at all.
PASO_ALLOW_MAINNET=

# Secret key (S...) of the Stellar mainnet account that pays the fees there. It must be an account of its own:
# the testnet relayer's secret is refused.
RELAYER_SECRET_MAINNET=

# Optional. Soroban RPC and Base RPC endpoints for mainnet; the public endpoints when not set.
STELLAR_RPC_URL_MAINNET=
BASE_RPC_URL_MAINNET=

# Optional. The most one transaction may cost in resource fees on mainnet, in stroops. Defaults to 3000000 (0.3 XLM).
RELAYER_MAX_RESOURCE_FEE_MAINNET=

# Optional. The most the relayer spends on fees on mainnet in any 24 hours, in stroops. Defaults to 20000000 (2 XLM).
# A delivery from Base costs about 0.07 XLM and is the largest item.
RELAYER_MAX_DAILY_FEES_MAINNET=

# Optional. What the mainnet relayer account keeps, in stroops. Defaults to 20000000 (2 XLM): below it nothing is paid.
RELAYER_MIN_BALANCE_MAINNET=

# Optional. What a mainnet transaction bids to be included, in stroops. Defaults to 100000 (0.01 XLM); a transaction
# that bid the 100-stroop minimum has been left out of every ledger there. Doubled on each resend, three at most.
RELAYER_INCLUSION_FEE_MAINNET=

# Optional. Transactions paid for in an hour on mainnet, from one caller and from everyone together.
# Defaults: 8 and 40 relayed calls, 3 and 12 account deployments, 6 and 20 deliveries.
RELAYS_PER_CALLER_PER_HOUR_MAINNET=
RELAYS_PER_HOUR_MAINNET=
DEPLOYS_PER_CALLER_PER_HOUR_MAINNET=
DEPLOYS_PER_HOUR_MAINNET=
DELIVERIES_PER_CALLER_PER_HOUR_MAINNET=
DELIVERIES_PER_HOUR_MAINNET=

# Must be "true", on top of the above, for the server to pay for mints on Base on mainnet. Off by default: the owner's
# wallet submits the mint. It also needs BASE_PAYER_PRIVATE_KEY_MAINNET, the server's account on Base mainnet.
PAY_BASE_MINTS_ON_MAINNET=
BASE_PAYER_PRIVATE_KEY_MAINNET=
# ---------------------------------------------------------------------------------------------------------------------

# Tests and scripts: Ethereum private key (0x...) of an owner whose account is deployed on testnet.
# The synthetic-wallet journey (pnpm --filter @paso/web e2e) signs and pays on Base with it; see test/e2e/playwright.config.ts.
PASO_E2E_OWNER_KEY=

# Tests and scripts: secret key (S...) of any funded Stellar testnet account. It may be the relayer's.
PASO_E2E_SOURCE_SECRET=

# Scripts, optional: Ethereum private key (0x...) that pays the burn on Base Sepolia. Defaults to DEMO_PAYER_PRIVATE_KEY, then PASO_E2E_OWNER_KEY.
PASO_E2E_PAYER_KEY=
